    "name": "YiYi Book REST API Tests",
    "description": "Collection test API tự động cho dự án website bán sách YiYi Book - Môn học Kiểm chứng phần mềm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
